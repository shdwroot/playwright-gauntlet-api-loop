# .env is loaded beside the selected config without overriding exported values. Never put real values in config files.
SAMPLE_API_KEY=gauntlet-local-key

# Optional API target override; otherwise uses baseUrl in the selected config.
# Keep safety.allowedHosts and safety.allowProduction configured for this target.
# GAUNTLET_BASE_URL=http://127.0.0.1:4010

# Required for the default six-role Luna agent configuration.
# OPENAI_API_KEY=

# Optional model override used only with --agentic when --model is omitted.
# OPENAI_MODEL=gpt-5.6-luna

# Direct overrides apply even when selecting a different config; leave unset for offline exercises.
# GAUNTLET_AGENT_PROVIDER=openai
# GAUNTLET_AGENT_MODEL=gpt-5.6-luna
# Restart watch after changing .env; existing loaded environment values take precedence.
