# .env is loaded beside the selected config without overriding exported values. Never put real values in config files.
SAMPLE_API_KEY=gauntlet-local-key

# Optional API target override; otherwise uses baseUrl in the selected config.
# Keep safety.allowedHosts and safety.allowProduction configured for this target.
# GAUNTLET_BASE_URL=http://127.0.0.1:4010

# Repair workflow. CLI --workflow overrides this; default is tests-only.
# tests-only: generate/repair tests and report API defects; never edit API source.
# source-repair: also allow scoped API source edits, verification and restart.
# GAUNTLET_WORKFLOW=tests-only
# Local clone of the API repository, NOT its HTTP endpoint or Git remote URL.
# Use an absolute path. No repository is cloned automatically.
# GAUNTLET_API_SOURCE=/absolute/path/to/your-api-repo
# Supported local Compose apps can infer repair commands from this checkout.
# Other apps require sourceRepair.root/include/verifyCommand/restartCommand in config.
# The env path must match an existing sourceRepair.root to avoid restarting the wrong app.

# Required for the default six-role Luna agent configuration.
# OPENAI_API_KEY=

# Optional model override for URL onboarding or --agentic when --model is omitted.
# OPENAI_MODEL=gpt-5.6-luna

# Direct overrides apply even when selecting a different config; leave unset for offline exercises.
# GAUNTLET_AGENT_PROVIDER=openai
# GAUNTLET_AGENT_MODEL=gpt-5.6-luna
# Restart watch after changing .env; existing loaded environment values take precedence.

# Azure OpenAI alternative (v1 Responses API).
# Model values must be YOUR Azure deployment names, not generic model IDs.
# Requires a deployment supporting Responses API and structured JSON-schema output.
# GAUNTLET_AGENT_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
# GAUNTLET_AGENT_MODEL, when set, overrides AZURE_OPENAI_DEPLOYMENT.
# Leave both model overrides unset to use separate role deployments in config.
