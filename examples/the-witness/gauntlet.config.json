{
  "projectName": "the-witness-contract-lab",
  "spec": "openapi.yaml",
  "baseUrl": "http://127.0.0.1:4030",
  "generatedDir": ".gauntlet/generated",
  "artifactsDir": ".gauntlet/runs",
  "seed": 42,
  "maxIterations": 3,
  "timeoutMs": 30000,
  "headersFromEnv": {
    "authorization": "WITNESS_AUTHORIZATION"
  },
  "safety": {
    "allowedHosts": ["127.0.0.1"],
    "allowedMethods": ["GET", "POST", "PATCH"],
    "allowDestructive": true,
    "allowProduction": false,
    "maxRequestsPerRun": 80,
    "maxResponseBytes": 65536
  },
  "agents": {
    "provider": "openai",
    "builderModel": "gpt-5.6-luna",
    "criticModel": "gpt-5.6-luna",
    "apiKeyEnv": "OPENAI_API_KEY"
  },
  "quality": {
    "minimumScore": 95,
    "minimumOperationCoverage": 0.9
  },
  "discovery": {
    "enabled": true,
    "required": true,
    "sources": [
      {
        "id": "witness-route-notes",
        "path": "route-observations.log",
        "kind": "log"
      }
    ],
    "minimumConfidence": 0.85
  }
}
