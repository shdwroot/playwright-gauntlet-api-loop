{
  "projectName": "the-witness-production-safe",
  "spec": "openapi.safe.yaml",
  "baseUrl": "https://the-witness-api.onrender.com",
  "generatedDir": ".gauntlet/generated",
  "artifactsDir": ".gauntlet/runs",
  "seed": 42,
  "maxIterations": 3,
  "timeoutMs": 60000,
  "safety": {
    "allowedHosts": ["the-witness-api.onrender.com"],
    "allowedMethods": ["GET"],
    "allowDestructive": false,
    "allowProduction": true,
    "maxRequestsPerRun": 12,
    "maxResponseBytes": 65536
  },
  "agents": {
    "provider": "openai",
    "builderModel": "gpt-5.6-luna",
    "criticModel": "gpt-5.6-luna",
    "apiKeyEnv": "OPENAI_API_KEY"
  },
  "quality": {
    "minimumScore": 95,
    "minimumOperationCoverage": 1
  },
  "discovery": {
    "enabled": false,
    "required": false,
    "sources": [],
    "minimumConfidence": 0.85
  }
}
