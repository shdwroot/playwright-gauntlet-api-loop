{
  "projectName": "sample-users-api",
  "spec": "specs/sample-api.yaml",
  "baseUrl": "http://127.0.0.1:4010",
  "generatedDir": ".gauntlet/generated",
  "artifactsDir": ".gauntlet/runs",
  "seed": 42,
  "maxIterations": 3,
  "timeoutMs": 30000,
  "headersFromEnv": {
    "x-api-key": "SAMPLE_API_KEY"
  },
  "discovery": {
    "enabled": true,
    "required": true,
    "sources": [
      {
        "id": "project-context",
        "path": "context",
        "kind": "auto"
      }
    ],
    "allowedExtensions": [
      ".json",
      ".jsonl",
      ".log",
      ".md",
      ".txt",
      ".yaml",
      ".yml"
    ],
    "maxFiles": 100,
    "maxFileBytes": 5242880,
    "maxTotalBytes": 26214400,
    "maxCandidates": 5000,
    "maxCandidatesPerOperation": 20,
    "maxExcerptCharacters": 512,
    "minimumConfidence": 0.85
  },
  "safety": {
    "allowedHosts": [
      "127.0.0.1",
      "localhost"
    ],
    "allowedMethods": [
      "GET",
      "POST",
      "DELETE"
    ],
    "allowDestructive": true,
    "allowProduction": false,
    "maxRequestsPerRun": 100,
    "maxResponseBytes": 65536
  },
  "agents": {
    "provider": "openai",
    "builderModel": "gpt-5.6-luna",
    "criticModel": "gpt-5.6-luna",
    "discoveryModel": "gpt-5.6-luna",
    "leadModel": "gpt-5.6-luna",
    "healerModel": "gpt-5.6-luna",
    "timeoutMs": 120000
  },
  "quality": {
    "minimumScore": 95,
    "minimumOperationCoverage": 1
  }
}
